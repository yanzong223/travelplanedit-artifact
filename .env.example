# OpenAI-compatible API endpoint.
DMXAPI_BASE_URL=https://example.com/v1
DMXAPI_API_KEY=your_api_key_here

# Use a key from configs/model_router.yaml, or a direct model name supported by your endpoint.
DMXAPI_MODEL=deepseek_v4_pro_guan

# Optional generation budgets.
DMXAPI_REACT_MAX_COMPLETION_TOKENS=65536
DMXAPI_REACT_JSON_REPAIR_MAX_TOKENS=8000
